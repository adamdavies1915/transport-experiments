{
  "name": "nola-transit-scraper",
  "version": "2.0.0",
  "description": "Collects RTA relay and LePass observations with local analysis and a guarded MotherDuck archive",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/collector-entry.ts",
    "dev": "tsx watch src/collector-entry.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts scripts/import-server-history.test.ts",
    "otp:backfill": "tsx src/otp-worker.ts",
    "otp:validate": "tsx src/otp-validation.ts",
    "streetcars:backfill": "tsx src/streetcar-worker.ts",
    "study:backfill": "node --import tsx src/local-worker.ts --backfill",
    "history:import": "node --import tsx scripts/import-server-history.ts",
    "process:daily": "node --import tsx scripts/process-daily.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.4-r.1",
    "@js-temporal/polyfill": "^0.5.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.2.3",
    "eventsource": "^2.0.2",
    "fflate": "^0.8.3",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.3.0"
  }
}
