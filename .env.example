# local (default): both feeds, durable journal and optional workstation analysis.
# cloud: compatibility SSE -> existing MotherDuck tables; no analysis or raw spool.
COLLECTOR_MODE=local
# Persistent collector data: mount this directory across deployments.
TRANSIT_DATA_DIR=./runtime-data
# Local default is 3100. Cloud default is 3000; set the selected port in Coolify.
PORT=3100
TRANSIT_SUMMARY_TOKEN=replace-with-a-long-random-server-only-token
# Optional workstation -> cloud collector summary publication. Use a different
# token of at least 32 characters; only the workstation sets the HTTPS URL.
TRANSIT_SUMMARY_PUBLISH_URL=
TRANSIT_SUMMARY_PUBLISH_TOKEN=

SSE_URL=https://nolatransit.fly.dev/sse
GTFS_URL=https://www.norta.com/RTA/media/GTFS/GTFS.zip
STALE_FEED_THRESHOLD=300000

# In local mode MotherDuck is optional. Cloud mode requires this for real writes.
MOTHER_DUCK_API_KEY=your_motherduck_token_here
MOTHERDUCK_DATABASE=my_db
MOTHERDUCK_BOOTSTRAP=true
# Local mode archive writes remain false until Lite usage has been verified.
# This flag does not disable the explicit cloud mode's existing SSE ingestion.
MOTHERDUCK_CLOUD_WRITES=false
MOTHERDUCK_USAGE_FILE=./runtime-data/motherduck-usage.json
TRANSIT_RESULTS_DATABASE=transit_results
UPLOAD_INTERVAL=900000
ANALYSIS_INTERVAL=900000
LOCAL_DB_MEMORY=1GB
LOCAL_DB_THREADS=2
# False for a capture-only server or during offline database maintenance.
LOCAL_ANALYSIS_ENABLED=true

# Optional server capture + daily desktop/Mac processing. Keep disabled until
# both machines share a verified processing seed and server storage is ready.
PROCESSING_SERVER_ENABLED=false
PROCESSING_BASELINE_ID=
TRANSIT_PROCESSING_TOKEN=
PROCESSING_DUE_HOUR=6
PROCESSING_LEASE_SECONDS=900
# Workstation-only: collector HTTPS origin; no LePass/MotherDuck secrets required.
PROCESSING_SERVER_URL=
PROCESSING_WORKER_ID=

# Existing verified guest credentials live encrypted in TRANSIT_DATA_DIR/lepass.
LEPASS_ENABLED=false
LEPASS_API_KEY=
LEPASS_ENCRYPTION_KEY=
LEPASS_ALLOW_GUEST_BOOTSTRAP=false
LEPASS_QUERIES_FILE=./src/data/lepass-queries.json
