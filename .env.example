# MotherDuck (required) — the code reads MOTHER_DUCK_API_KEY
MOTHER_DUCK_API_KEY=your_motherduck_token_here
MOTHERDUCK_DATABASE=my_db

# SSE endpoint
SSE_URL=https://nolatransit.fly.dev/sse

# Insert buffered records into MotherDuck every N ms (default: 60s)
UPLOAD_INTERVAL=60000

# Reconnect delay in milliseconds
RECONNECT_DELAY=5000
