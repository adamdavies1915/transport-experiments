{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "scripts/process-daily.ts", "scripts/process-cloud-history.ts", "scripts/capture-workstation.ts", "scripts/review-route12-geometry.ts", "scripts/export-focused-study.ts"]
}
