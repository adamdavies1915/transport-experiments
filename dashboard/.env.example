# Server-only settings. No database or object-storage credentials reach the browser.
PORT=3000
TRANSIT_SUMMARY_URL=http://localhost:3100/internal/summary
TRANSIT_SUMMARY_TOKEN=replace-with-the-collector-read-token
TRANSIT_SUMMARY_CACHE_FILE=./data/transit-summary.json
# 35 minutes for the continuously running local analysis worker.
TRANSIT_SUMMARY_STALE_MS=2100000
